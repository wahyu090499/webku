# Salin file ini menjadi .env dan sesuaikan nilainya

# Port server (default: 3000)
PORT=3000

# Secret untuk session - GANTI dengan string acak yang panjang!
SESSION_SECRET=ganti-dengan-string-rahasia-yang-sangat-panjang-dan-acak

# Environment: development | production
NODE_ENV=production

# Nama website (untuk SEO)
SITE_NAME=WebKu
SITE_URL=https://domain-kamu.com

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Admin Panel' %> – WebKu</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --white: #ffffff;
      --bg: #f5f4f1;
      --surface: #ffffff;
      --border: #e4e1db;
      --border-strong: #ccc9c2;
      --navy: #0f1f3d;
      --navy-mid: #1a3260;
      --slate: #4a5568;
      --gold: #c9a84c;
      --gold-light: #e8c97a;
      --text: #1a1a2e;
      --muted: #6b7280;
      --danger: #dc2626;
      --danger-bg: #fef2f2;
      --success: #16a34a;
      --success-bg: #f0fdf4;
      --sidebar-w: 240px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: var(--bg); color: var(--text);
      font-family: 'Outfit', sans-serif;
      display: flex; min-height: 100vh; font-size: 0.9rem;
    }

    /* SIDEBAR */
    .sidebar {
      width: var(--sidebar-w); background: var(--navy);
      display: flex; flex-direction: column;
      position: fixed; top: 0; left: 0; height: 100vh; z-index: 50;
    }
    .sidebar-logo {
      padding: 1.5rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.08);
      font-family: 'Playfair Display', serif; font-weight: 800; font-size: 1.35rem;
      color: var(--white); letter-spacing: -0.02em;
    }
    .sidebar-logo span { color: var(--gold); }
    .sidebar-logo small {
      display: block; font-size: 0.65rem; font-weight: 400;
      color: rgba(255,255,255,0.35); margin-top: 0.2rem;
      font-family: 'Outfit', sans-serif; letter-spacing: 0.06em; text-transform: uppercase;
    }
    .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
    .nav-section {
      padding: 0.75rem 1.25rem 0.3rem;
      font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: rgba(255,255,255,0.25);
    }
    .sidebar-nav a {
      display: flex; align-items: center; gap: 0.7rem;
      padding: 0.6rem 1.25rem; color: rgba(255,255,255,0.5);
      text-decoration: none; font-size: 0.85rem; font-weight: 500;
      transition: all 0.15s; position: relative;
    }
    .sidebar-nav a:hover { color: rgba(255,255,255,0.85); background: rgba(255,255,255,0.05); }
    .sidebar-nav a.active {
      color: var(--white); background: rgba(201,168,76,0.12);
      border-right: 2px solid var(--gold);
    }
    .sidebar-nav a .icon { width: 16px; text-align: center; font-size: 0.9rem; }
    .sidebar-footer {
      padding: 1rem 1.25rem; border-top: 1px solid rgba(255,255,255,0.08);
    }
    .user-info { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
    .user-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--gold); display: flex; align-items: center;
      justify-content: center; font-weight: 700; font-size: 0.8rem;
      color: var(--navy); flex-shrink: 0;
    }
    .user-name { font-size: 0.82rem; font-weight: 600; color: var(--white); }
    .user-role { font-size: 0.68rem; color: rgba(255,255,255,0.35); margin-top: 0.05rem; }
    .logout-btn {
      display: flex; align-items: center; gap: 0.4rem;
      color: rgba(255,255,255,0.35); text-decoration: none;
      font-size: 0.78rem; font-weight: 500; transition: color 0.2s;
    }
    .logout-btn:hover { color: var(--gold); }

    /* MAIN */
    .main { margin-left: var(--sidebar-w); flex: 1; display: flex; flex-direction: column; min-height: 100vh; }
    .topbar {
      padding: 0 2rem; border-bottom: 1px solid var(--border);
      background: var(--white); display: flex; align-items: center;
      justify-content: space-between; height: 60px;
      position: sticky; top: 0; z-index: 10;
    }
    .topbar h1 { font-family: 'Playfair Display', serif; font-size: 1.05rem; font-weight: 700; color: var(--navy); }
    .page-content { padding: 2rem; flex: 1; max-width: 1100px; }

    /* ALERTS */
    .alert {
      padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.85rem;
      font-weight: 500; margin-bottom: 1.5rem;
      display: flex; align-items: center; gap: 0.5rem; border: 1px solid;
    }
    .alert-success { background: var(--success-bg); border-color: #bbf7d0; color: var(--success); }
    .alert-error { background: var(--danger-bg); border-color: #fecaca; color: var(--danger); }

    /* CARDS */
    .card {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 12px; padding: 1.5rem; margin-bottom: 1.5rem;
    }
    .card-title {
      font-weight: 700; font-size: 0.9rem; color: var(--navy);
      margin-bottom: 1.25rem; padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 0.5rem;
    }

    /* FORMS */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .form-group.full { grid-column: 1/-1; }
    label { font-size: 0.78rem; font-weight: 600; color: var(--slate); }
    input[type=text], input[type=password], input[type=email], input[type=number], textarea, select {
      background: var(--bg); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.6rem 0.85rem;
      color: var(--text); font-family: 'Outfit', sans-serif;
      font-size: 0.875rem; width: 100%; transition: border-color 0.2s;
    }
    input:focus, textarea:focus, select:focus {
      outline: none; border-color: var(--navy);
      background: var(--white);
    }
    textarea { resize: vertical; min-height: 80px; }
    input[type=file] { padding: 0.5rem 0.85rem; font-size: 0.82rem; }

    /* BUTTONS */
    .btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.55rem 1.2rem; border-radius: 8px; border: 1px solid transparent;
      cursor: pointer; font-size: 0.85rem; font-weight: 600;
      font-family: 'Outfit', sans-serif; transition: all 0.15s;
      text-decoration: none; white-space: nowrap;
    }
    .btn:active { transform: scale(0.98); }
    .btn-primary { background: var(--navy); color: var(--white); border-color: var(--navy); }
    .btn-primary:hover { background: var(--navy-mid); }
    .btn-gold { background: var(--gold); color: var(--navy); border-color: var(--gold); }
    .btn-gold:hover { background: var(--gold-light); }
    .btn-ghost { background: transparent; color: var(--slate); border-color: var(--border); }
    .btn-ghost:hover { border-color: var(--navy); color: var(--navy); }
    .btn-danger { background: transparent; color: var(--danger); border-color: #fecaca; }
    .btn-danger:hover { background: var(--danger); color: var(--white); border-color: var(--danger); }

    /* TABLE */
    table { width: 100%; border-collapse: collapse; }
    th {
      text-align: left; padding: 0.6rem 0.75rem;
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.06em; color: var(--muted);
      border-bottom: 2px solid var(--border); background: var(--bg);
    }
    td { padding: 0.75rem; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--bg); }

    /* BADGE */
    .badge {
      display: inline-block; padding: 0.2rem 0.65rem;
      border-radius: 100px; font-size: 0.7rem; font-weight: 700;
    }
    .badge-admin { background: rgba(15,31,61,0.1); color: var(--navy); }
    .badge-editor { background: rgba(201,168,76,0.15); color: #92700a; }

    /* MODAL */
    .modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(15,31,61,0.5); z-index: 200;
      align-items: center; justify-content: center;
      backdrop-filter: blur(4px);
    }
    .modal-overlay.open { display: flex; }
    .modal {
      background: var(--white); border: 1px solid var(--border);
      border-radius: 16px; padding: 2rem;
      width: 90%; max-width: 520px; max-height: 90vh; overflow-y: auto;
      box-shadow: 0 20px 60px rgba(15,31,61,0.2);
    }
    .modal-title { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.1rem; color: var(--navy); margin-bottom: 1.5rem; }
    .modal-actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; justify-content: flex-end; }

    @media (max-width: 768px) {
      .sidebar { width: 200px; }
      .main { margin-left: 200px; }
      .form-grid { grid-template-columns: 1fr; }
      .page-content { padding: 1rem; }
    }
  </style>
</head>
<body>

<aside class="sidebar">
  <div class="sidebar-logo">
    Web<span>Ku</span>
    <small>Admin Panel</small>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Utama</div>
    <a href="/admin/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">
      <span class="icon">◈</span> Dashboard
    </a>
    <a href="/" target="_blank"><span class="icon">↗</span> Lihat Website</a>
    <div class="nav-section">Konten</div>
    <a href="/admin/content" class="<%= page === 'content' ? 'active' : '' %>">
      <span class="icon">✎</span> Edit Konten
    </a>
    <a href="/admin/gallery" class="<%= page === 'gallery' ? 'active' : '' %>">
      <span class="icon">⊞</span> Galeri
    </a>
    <a href="/admin/packages" class="<%= page === 'packages' ? 'active' : '' %>">
      <span class="icon">❖</span> Paket Layanan
    </a>
    <a href="/admin/testimonials" class="<%= page === 'testimonials' ? 'active' : '' %>">
      <span class="icon">❝</span> Testimoni
    </a>
    <% if (user && user.role === 'admin') { %>
    <div class="nav-section">Pengaturan</div>
    <a href="/admin/users" class="<%= page === 'users' ? 'active' : '' %>">
      <span class="icon">⊛</span> Manajemen User
    </a>
    <% } %>
  </nav>
  <div class="sidebar-footer">
    <div class="user-info">
      <div class="user-avatar"><%= (user && user.name) ? user.name.charAt(0).toUpperCase() : 'U' %></div>
      <div>
        <div class="user-name"><%= user ? user.name : 'User' %></div>
        <div class="user-role"><%= user && user.role === 'admin' ? 'Administrator' : 'Editor' %></div>
      </div>
    </div>
    <a href="/auth/logout" class="logout-btn">↩ Keluar</a>
  </div>
</aside>

<main class="main">
  <div class="topbar">
    <h1><%= title || 'Dashboard' %></h1>
    <a href="/" target="_blank" class="btn btn-ghost" style="font-size:0.78rem;padding:0.4rem 0.9rem;">↗ Preview Website</a>
  </div>
  <div class="page-content">

<%- include('_header', { title: 'Dashboard', page: 'dashboard', user }) %>

<% if (user.role === 'admin') { %>
<div style="background:#f0f4ff;border:1px solid #e0e8ff;border-radius:12px;padding:1rem 1.25rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem;font-size:0.875rem;">
  🔐 <strong>Mode Admin</strong> — Kamu memiliki akses penuh termasuk manajemen user.
</div>
<% } %>

<!-- STATS -->
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:2rem;">
  <div class="card" style="text-align:center;padding:1.5rem;margin-bottom:0;">
    <div style="font-size:2rem;margin-bottom:0.5rem;">🖼️</div>
    <div style="font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;"><%= galleryCount %></div>
    <div style="color:var(--muted);font-size:0.8rem;">Foto Galeri</div>
  </div>
  <div class="card" style="text-align:center;padding:1.5rem;margin-bottom:0;">
    <div style="font-size:2rem;margin-bottom:0.5rem;">💬</div>
    <div style="font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;"><%= testiCount %></div>
    <div style="color:var(--muted);font-size:0.8rem;">Testimoni</div>
  </div>
  <div class="card" style="text-align:center;padding:1.5rem;margin-bottom:0;">
    <div style="font-size:2rem;margin-bottom:0.5rem;">📦</div>
    <div style="font-family:'Syne',sans-serif;font-size:2rem;font-weight:800;"><%= pkgCount %></div>
    <div style="color:var(--muted);font-size:0.8rem;">Paket Layanan</div>
  </div>
</div>

<!-- QUICK ACTIONS -->
<div class="card">
  <div class="card-title">⚡ Aksi Cepat</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:0.75rem;">
    <a href="/admin/content" class="btn btn-primary" style="justify-content:center;padding:0.85rem;">✏️ Edit Konten</a>
    <a href="/admin/gallery" class="btn btn-ghost" style="justify-content:center;padding:0.85rem;">🖼️ Upload Foto</a>
    <a href="/admin/testimonials" class="btn btn-ghost" style="justify-content:center;padding:0.85rem;">💬 Tambah Testimoni</a>
    <a href="/admin/packages" class="btn btn-ghost" style="justify-content:center;padding:0.85rem;">📦 Edit Paket</a>
    <a href="/" target="_blank" class="btn btn-ghost" style="justify-content:center;padding:0.85rem;">🌐 Preview Website</a>
  </div>
</div>

<!-- GUIDE -->
<div class="card">
  <div class="card-title">📖 Panduan Cepat</div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
    <div style="background:var(--bg);border-radius:12px;padding:1rem;">
      <div style="font-weight:700;margin-bottom:0.5rem;font-size:0.9rem;">1. Edit Konten Landing Page</div>
      <div style="color:var(--muted);font-size:0.82rem;line-height:1.6;">Pergi ke <strong>Edit Konten</strong> untuk mengubah teks hero, about, nomor WA, dan lainnya.</div>
    </div>
    <div style="background:var(--bg);border-radius:12px;padding:1rem;">
      <div style="font-weight:700;margin-bottom:0.5rem;font-size:0.9rem;">2. Upload Foto Portfolio</div>
      <div style="color:var(--muted);font-size:0.82rem;line-height:1.6;">Buka <strong>Galeri</strong> untuk mengunggah foto hasil kerja / portfolio website klien.</div>
    </div>
    <div style="background:var(--bg);border-radius:12px;padding:1rem;">
      <div style="font-weight:700;margin-bottom:0.5rem;font-size:0.9rem;">3. Tambah Testimoni Klien</div>
      <div style="color:var(--muted);font-size:0.82rem;line-height:1.6;">Tambahkan testimoni dari klien untuk meningkatkan kepercayaan calon pelanggan.</div>
    </div>
    <div style="background:var(--bg);border-radius:12px;padding:1rem;">
      <div style="font-weight:700;margin-bottom:0.5rem;font-size:0.9rem;">4. Kelola Paket Layanan</div>
      <div style="color:var(--muted);font-size:0.82rem;line-height:1.6;">Edit harga dan fitur di setiap paket layanan sesuai kebutuhan promosi.</div>
    </div>
  </div>
</div>

<%- include('_footer') %>

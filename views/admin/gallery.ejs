<%- include('_header', { title: 'Manajemen Galeri', page: 'gallery', user }) %>

<% if (success) { %><div class="alert alert-success">✅ Galeri berhasil diperbarui!</div><% } %>
<% if (error) { %><div class="alert alert-error">❌ Upload gagal. Pastikan file adalah gambar (JPG/PNG) max 5MB.</div><% } %>

<!-- UPLOAD -->
<div class="card">
  <div class="card-title">⬆️ Upload Foto Baru</div>
  <form action="/admin/gallery/upload" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="form-group full">
        <label>Pilih Foto (bisa lebih dari 1, max 5MB per file, JPG/PNG/WebP)</label>
        <input type="file" name="images" multiple accept="image/*" style="padding:0.5rem;">
      </div>
      <div class="form-group full">
        <label>Caption (opsional, berlaku untuk semua foto yang diupload sekaligus)</label>
        <input type="text" name="caption" placeholder="Contoh: Website Toko Bu Sari">
      </div>
    </div>
    <div style="margin-top:1rem;"><button type="submit" class="btn btn-primary">⬆️ Upload Foto</button></div>
  </form>
</div>

<!-- GALLERY GRID -->
<div class="card">
  <div class="card-title">🖼️ Foto Galeri (<%= gallery.length %> foto)</div>
  <% if (gallery.length === 0) { %>
    <div style="text-align:center;padding:3rem;color:var(--muted);">
      <div style="font-size:3rem;margin-bottom:1rem;">📁</div>
      <p>Belum ada foto. Upload foto portfolio pertamamu!</p>
    </div>
  <% } else { %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;">
    <% gallery.forEach(item => { %>
    <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;overflow:hidden;">
      <div style="aspect-ratio:4/3;overflow:hidden;">
        <img src="<%= item.path %>" alt="<%= item.caption %>" style="width:100%;height:100%;object-fit:cover;">
      </div>
      <div style="padding:0.75rem;">
        <input type="text" value="<%= item.caption || '' %>" placeholder="Caption..."
          style="font-size:0.8rem;padding:0.4rem 0.6rem;margin-bottom:0.5rem;"
          onblur="updateCaption('<%= item._id %>', this.value)" onkeydown="if(event.key==='Enter') this.blur()">
        <form action="/admin/gallery/delete/<%= item._id %>" method="POST" onsubmit="return confirm('Hapus foto ini?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger" style="width:100%;padding:0.4rem;font-size:0.78rem;">🗑️ Hapus</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
</div>

<script>
async function updateCaption(id, caption) {
  try {
    const res = await fetch('/admin/gallery/caption/' + id, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ caption })
    });
    if (res.ok) {
      const input = event.target;
      input.style.borderColor = 'var(--accent3)';
      setTimeout(() => input.style.borderColor = '', 1500);
    }
  } catch(e) {}
}
</script>

<%- include('_footer') %>

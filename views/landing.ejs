      <% } else { %>
        <% gallery.forEach(item => { %>
        <div class="gallery-item">
          <img src="<%= item.path %>" alt="<%= item.caption || 'Portfolio' %>" loading="lazy">
          <% if (item.caption) { %><div class="gallery-caption"><%= item.caption %></div><% } %>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>


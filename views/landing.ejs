        <a href="#paket" class="btn-outline-white">Lihat Paket</a>
      </div>
      <div class="hero-stats">
        <div>
          <div class="stat-num"><%= stats.websites || '20+' %></div>
          <div class="stat-label">Website Dibuat</div>
        </div>
        <div>
          <div class="stat-num"><%= stats.clients || '15+' %></div>
          <div class="stat-label">Klien Aktif</div>
        </div>
        <div>
          <div class="stat-num"><%= stats.years || '2+' %></div>
          <div class="stat-label">Tahun Pengalaman</div>
        </div>
        <div>
          <div class="stat-num"><%= stats.satisfaction || '100%' %></div>
          <div class="stat-label">Kepuasan Klien</div>
        </div>
      </div>
    </div>
    <div class="hero-card">
      <div class="hero-card-label">✦ Yang kamu dapatkan gratis</div>

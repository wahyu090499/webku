      <div class="hero-free-item"><div class="check">✓</div>Halaman Admin untuk Konfigurasi Konten</div>
      <div class="hero-free-item"><div class="check">✓</div>Integrasi Tombol WhatsApp & Sosial Media</div>
      <div class="hero-free-item"><div class="check">✓</div>Galeri Dokumentasi Produk / Kegiatan</div>
      <div class="hero-card-footer">
        Cukup bayar <strong><%= freeOffer.priceHosting || 'Rp 300rb/tahun' %></strong> untuk hosting &amp; domain
      </div>
    </div>
  </div>
</section>

<!-- FREE OFFER -->
<section id="gratis">
